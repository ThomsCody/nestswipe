[Unit]
Description=Nestswipe idle overnight reboot watcher
After=docker.service datadog-agent.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nestswipe-reboot-watch --apply
TimeoutStartSec=180
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/nestswipe-reboot /var/lib/dpkg
