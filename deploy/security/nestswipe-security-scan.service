[Unit]
Description=Scan exact Nestswipe production container images
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nestswipe-security-monitor scan
TimeoutStartSec=100min
User=root
UMask=0077
Nice=19
CPUQuota=50%
MemoryMax=2G
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/nestswipe-security /var/cache/nestswipe-trivy
