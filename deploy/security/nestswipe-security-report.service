[Unit]
Description=Nestswipe backup, reboot and vulnerability service checks
After=datadog-agent.service docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nestswipe-security-monitor report
TimeoutStartSec=60
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
