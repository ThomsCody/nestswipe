{
  "name": "Nestswipe: scheduled listing access check failed",
  "type": "query alert",
  "query": "max(last_4h):min:nestswipe.listing_probe.healthy{service:nestswipe-backend,env:prod,!listing_source:leboncoin} by {listing_source}.fill(null) < 1",
  "message": "Retired: synthetic provider checks are disabled. Provider failure notifications now use the real-email listing access failure monitor. Do not enable scheduled listing tests.",
  "tags": [
    "service:nestswipe-backend",
    "env:prod",
    "application:nestswipe",
    "managed_by:nestswipe"
  ],
  "priority": 3,
  "options": {
    "thresholds": {
      "critical": 1
    },
    "include_tags": true,
    "on_missing_data": "resolve",
    "require_full_window": false,
    "new_group_delay": 14400,
    "renotify_interval": 0
  },
  "retired": true,
  "notification_enabled": false
}
